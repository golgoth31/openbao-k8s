[
  {
    "op": "add",
    "path": "/spec/volumes/-",
    "value": {
      "emptyDir": {
        "medium": "Memory"
      },
      "name": "home-init"
    }
  },
  {
    "op": "add",
    "path": "/spec/volumes/-",
    "value": {
      "emptyDir": {
        "medium": "Memory"
      },
      "name": "home-sidecar"
    }
  },
  {
    "op": "add",
    "path": "/spec/volumes/-",
    "value": {
      "emptyDir": {
        "medium": "Memory"
      },
      "name": "openbao-secrets"
    }
  },
  {
    "op": "add",
    "path": "/spec/volumes/-",
    "value": {
      "configMap": {
        "name": "agent-config"
      },
      "name": "openbao-config"
    }
  },
  {
    "op": "add",
    "path": "/spec/containers/0/volumeMounts/-",
    "value": {
      "mountPath": "/vault/secrets",
      "name": "openbao-secrets"
    }
  },
  {
    "op": "add",
    "path": "/spec/containers/1/volumeMounts",
    "value": [
      {
        "mountPath": "/vault/secrets",
        "name": "openbao-secrets"
      }
    ]
  },
  {
    "op": "add",
    "path": "/spec/initContainers",
    "value": [
      {
        "args": [
          "touch /home/openbao/.openbao-token && bao agent -config=/vault/configs/config-init.hcl"
        ],
        "command": [
          "/bin/sh",
          "-ec"
        ],
        "env": [
          {
            "name": "NAMESPACE",
            "valueFrom": {
              "fieldRef": {
                "fieldPath": "metadata.namespace"
              }
            }
          },
          {
            "name": "HOST_IP",
            "valueFrom": {
              "fieldRef": {
                "fieldPath": "status.hostIP"
              }
            }
          },
          {
            "name": "POD_IP",
            "valueFrom": {
              "fieldRef": {
                "fieldPath": "status.podIP"
              }
            }
          },
          {
            "name": "BAO_LOG_LEVEL",
            "value": "info"
          },
          {
            "name": "BAO_LOG_FORMAT",
            "value": "standard"
          },
          {
            "name": "HTTPS_PROXY",
            "value": "http://proxy:3128"
          },
          {
            "name": "BAO_ADDR",
            "value": "http://foobar:8200"
          },
          {
            "name": "BAO_SKIP_VERIFY",
            "value": "false"
          }
        ],
        "image": "foobar-image",
        "name": "openbao-agent-init",
        "resources": {
          "limits": {
            "cpu": "500m",
            "memory": "128Mi"
          },
          "requests": {
            "cpu": "250m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true,
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 100
        },
        "volumeMounts": [
          {
            "mountPath": "/home/openbao",
            "name": "home-init"
          },
          {
            "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
            "name": "kube-api-access",
            "readOnly": true
          },
          {
            "mountPath": "/vault/secrets",
            "name": "openbao-secrets"
          },
          {
            "mountPath": "/vault/configs",
            "name": "openbao-config",
            "readOnly": true
          }
        ]
      }
    ]
  },
  {
    "op": "add",
    "path": "/spec/containers/-",
    "value": {
      "args": [
        "touch /home/openbao/.openbao-token && bao agent -config=/vault/configs/config.hcl"
      ],
      "command": [
        "/bin/sh",
        "-ec"
      ],
      "env": [
        {
          "name": "NAMESPACE",
          "valueFrom": {
            "fieldRef": {
              "fieldPath": "metadata.namespace"
            }
          }
        },
        {
          "name": "HOST_IP",
          "valueFrom": {
            "fieldRef": {
              "fieldPath": "status.hostIP"
            }
          }
        },
        {
          "name": "POD_IP",
          "valueFrom": {
            "fieldRef": {
              "fieldPath": "status.podIP"
            }
          }
        },
        {
          "name": "BAO_LOG_LEVEL",
          "value": "info"
        },
        {
          "name": "BAO_LOG_FORMAT",
          "value": "standard"
        },
        {
          "name": "HTTPS_PROXY",
          "value": "http://proxy:3128"
        },
        {
          "name": "BAO_ADDR",
          "value": "http://foobar:8200"
        },
        {
          "name": "BAO_SKIP_VERIFY",
          "value": "false"
        }
      ],
      "image": "foobar-image",
      "lifecycle": {},
      "name": "openbao-agent",
      "resources": {
        "limits": {
          "cpu": "500m",
          "memory": "128Mi"
        },
        "requests": {
          "cpu": "250m",
          "memory": "64Mi"
        }
      },
      "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
          "drop": [
            "ALL"
          ]
        },
        "readOnlyRootFilesystem": true,
        "runAsGroup": 1000,
        "runAsNonRoot": true,
        "runAsUser": 100
      },
      "volumeMounts": [
        {
          "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
          "name": "kube-api-access",
          "readOnly": true
        },
        {
          "mountPath": "/home/openbao",
          "name": "home-sidecar"
        },
        {
          "mountPath": "/vault/secrets",
          "name": "openbao-secrets"
        },
        {
          "mountPath": "/vault/configs",
          "name": "openbao-config",
          "readOnly": true
        }
      ]
    }
  },
  {
    "op": "add",
    "path": "/metadata/annotations/openbao.org~1agent-inject-status",
    "value": "injected"
  }
]
